# Secret used by Auth.js to sign sessions. Generate one with: npx auth secret
AUTH_SECRET=change-me-to-a-long-random-string

# The account with this email is the admin (Teresa).
ADMIN_EMAIL=teresa@origen.local

# SQLite file (created automatically). Swap the driver in src/db/index.ts for Postgres in production.
DATABASE_URL=./data/origen.db

# Shows one-click "Enter as demo user / Enter as Teresa" buttons on the login page.
# Set to false (or remove) in production.
DEMO_LOGIN=true
