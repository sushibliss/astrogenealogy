# Secret used by Auth.js to sign sessions. Generate one with: npx auth secret
AUTH_SECRET=change-me-to-a-long-random-string

# The account with this email is the admin (Teresa).
ADMIN_EMAIL=teresa@origen.local

# SQLite file (created automatically). Swap the driver in src/db/index.ts for Postgres in production.
DATABASE_URL=./data/origen.db

# One-click "Enter as a requester / Enter as Teresa" buttons on the home and sign-in pages.
# Always on in development unless set to false. In production it is off unless set to true.
DEMO_LOGIN=true

# ---- Marketing ----
# Public address of the site, without a trailing slash. Used for the sitemap,
# canonical links and share previews. Required before launch.
SITE_URL=https://www.example.com

# Measurement and advertising tags. Leave empty to load nothing (and show no
# cookie banner). When set, they load only after the visitor accepts, and only
# on public pages.
GA_ID=
GOOGLE_ADS_ID=
META_PIXEL_ID=
